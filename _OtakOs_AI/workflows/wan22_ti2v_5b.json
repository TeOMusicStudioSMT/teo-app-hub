{
  "_opis": "Wan 2.2 TI2V-5B — text-to-video na sprzecie Suwerena (RTX 3060 6 GB). Graf zlozony z ZYWYCH schematow /object_info tej instalacji, nie z pamieci. Nazwy plikow podmienia services/Wideo.js na to, co ComfyUI naprawde widzi.",
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "inputs": { "model": ["1", 0], "shift": 8.0 }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "PODMIEN_PROMPT" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "rozmyte, zniekształcone, artefakty, napisy, znak wodny, statyczny obraz, brzydkie dłonie" }
  },
  "7": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": { "vae": ["3", 0], "width": 704, "height": 480, "length": 49, "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["9", 0], "fps": 24.0 }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["10", 0], "filename_prefix": "katedra/scena", "format": "auto", "codec": "auto" }
  }
}
